  try { await runFfmpeg(e, id, src, ['-vn', '-c:a', 'libmp3lame', '-q:a', '2'], out, 'mp3'); }
  catch (x) { try { fs.unlinkSync(src); } catch (y) {} throw new Error(/does not contain any stream|matches no streams/i.test(x.message) ? 'LINK_NOAUDIO' : x.message); }
  try { fs.unlinkSync(src); } catch (x) {}
