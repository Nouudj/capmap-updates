ipcMain.handle('link-download', async (e, { id, url: raw, kind, quality }) => {
  const N = linkNormalize(raw); if (!N) throw new Error('LINK_BAD');
  const job = { cancelled: false }; LINKS.set(id, job);
  const send = (p, phase) => { try { e.sender.send('link-progress', { id, p, phase }); } catch (x) {} };
  try {
    // 1) not a video site: try it as a direct file
    if (!N.site) {
      const ctl = new AbortController(); job.abort = () => ctl.abort();
      const res = await net.fetch(N.url, { signal: ctl.signal, redirect: 'follow' });
      if (!res.ok) throw new Error('LINK_HTTP ' + res.status);
      const ct = (res.headers.get('content-type') || '').toLowerCase();
      const cd = res.headers.get('content-disposition') || '';
      let fname = (/filename\*=UTF-8''([^;]+)/i.exec(cd) || [])[1] || (/filename="?([^";]+)"?/i.exec(cd) || [])[1] || decodeURIComponent(new URL(res.url || N.url).pathname.split('/').pop() || '');
      try { fname = decodeURIComponent(fname); } catch (x) {}
      const media = /^(video|audio)\//.test(ct) || /\.(mp4|mov|m4v|mkv|webm|avi|ts|mts|flv|mp3|m4a|wav|aac|ogg|opus|flac)$/i.test(fname) || (/octet-stream/.test(ct) && /\.\w{2,4}$/.test(fname));
      if (media) {
        if (!/\.\w{2,4}$/.test(fname)) fname += ct.startsWith('audio/') ? '.mp3' : '.mp4';
        const out = path.join(CONV, 'link_' + Date.now().toString(36) + '_' + safeName(fname));
        const total = +res.headers.get('content-length') || 0; let got = 0;
        const ws = fs.createWriteStream(out);
        const rd = res.body.getReader();
        try {
          for (;;) { const { done, value } = await rd.read(); if (done) break; got += value.length;
            if (!ws.write(Buffer.from(value))) await new Promise(r => ws.once('drain', r));
            send(total ? Math.min(.98, got / total) * (kind === 'mp3' ? .85 : 1) : -got, 'download'); }
        } finally { await new Promise(r => ws.end(r)); }
        if (job.cancelled) { try { fs.unlinkSync(out); } catch (x) {} throw new Error('LINK_CANCEL'); }
        const fin = kind === 'mp3' ? await toMp3(e, id, out) : out;
        send(1, 'done'); return { ...linkResult(fin), via: 'direct' };
      }
      try { ctl.abort(); } catch (x) {}
      // an ordinary web page: only yt-dlp could read the video out of it
    }
    // 2) video sites and pages: yt-dlp, only when the user has it
    const yt = findYtdlp(); if (!yt) throw new Error(N.site ? 'NEED_YTDLP' : 'LINK_NOT_MEDIA');
    const q = { best: 4320, '1080': 1080, '720': 720, '480': 480 }[String(quality || 'best')] || 4320;
    const fmt = kind === 'mp3' ? ['-x', '--audio-format', 'mp3', '--audio-quality', '0']
      // H.264 (avc1) first: plays and seeks everywhere right away (vorschau, ClipMap-Ausschnitt). YouTube's mp4 streams above that are
      // often AV1, which many PCs cannot show without converting first (black picture). Only if there is no H.264 take the rest.
      : ['-f', `bv*[height<=${q}][vcodec^=avc1]+ba[ext=m4a]/bv*[height<=${q}][ext=mp4][vcodec!^=av01]+ba[ext=m4a]/bv*[height<=${q}][ext=mp4]+ba[ext=m4a]/bv*[height<=${q}]+ba/b[height<=${q}]/b`, '--merge-output-format', 'mp4'];
    // --print makes yt-dlp quiet, so the progress lines must be switched back on (--progress); -N loads several pieces at once
    const args = [...fmt, '--no-playlist', '--newline', '--progress', '-N', '4', '--no-mtime', '--restrict-filenames', '--ffmpeg-location', FFMPEG,
      '-o', path.join(CONV, 'link_%(title).70B_%(id)s.%(ext)s'), '--print', 'after_move:filepath', raw];
    const stages = kind === 'mp3' ? 1 : 2; let stage = 0, last = 0, outPath = '', err = '';
    await new Promise((resolve, reject) => {
      // apps started from the Dock/Finder do not get the shell PATH: add yt-dlp's own folder and the usual Homebrew folders,
      // so yt-dlp also finds its helpers (deno for YouTube, ffmpeg, python)
      const extra = [path.dirname(yt), ...(process.platform === 'win32' ? [] : ['/opt/homebrew/bin', '/usr/local/bin', path.join(os.homedir(), '.local', 'bin'), path.join(os.homedir(), '.deno', 'bin')])];
      const env = { ...process.env, PATH: [...extra, process.env.PATH || ''].join(path.delimiter) };
      const p = spawn(yt, args, { windowsHide: true, env }); job.proc = p;
      const onLine = l => {
        const m = /\[download\]\s+([\d.]+)%/.exec(l);
        if (m) { const v = +m[1]; if (v < last - 50) stage = Math.min(stages - 1, stage + 1); last = v; send(Math.min(.97, (stage + v / 100) / stages), 'ytdlp'); return; }
        if (/^\[(Merger|ExtractAudio|VideoConvertor)\]/.test(l)) send(.98, 'merge');
        const t = l.trim(); if (t && !t.startsWith('[') && fs.existsSync(t)) outPath = t;
      };
      let buf = '';
      p.stdout.on('data', d => { buf += d; const ls = buf.split(/\r?\n/); buf = ls.pop(); ls.forEach(onLine); });
      p.stderr.on('data', d => { err = (err + d).slice(-4000); });
      p.on('error', reject);
      p.on('close', code => { if (buf) onLine(buf); if (job.cancelled) reject(new Error('LINK_CANCEL')); else if (code === 0 && outPath) resolve(); else reject(new Error('YTDLP ' + (err.split('\n').filter(x => /ERROR/.test(x)).pop() || err.split('\n').slice(-2).join(' ')).trim())); });
    });
    send(1, 'done'); return { ...linkResult(outPath), via: 'ytdlp' };
  } finally { LINKS.delete(id); }
});
