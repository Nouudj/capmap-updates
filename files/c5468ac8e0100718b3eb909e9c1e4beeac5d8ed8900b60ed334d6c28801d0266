async function lsCall(what, params) {
  const ctl = new AbortController(), t = setTimeout(() => ctl.abort(), 15000);
  try {
    const r = await net.fetch('https://api.lemonsqueezy.com/v1/licenses/' + what, { method: 'POST', signal: ctl.signal,
      headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams(params).toString() });
    const j = await r.json().catch(() => ({}));
    return { net: true, status: r.status, j };
  } catch (e) { return { net: false }; } finally { clearTimeout(t); }
}
const licMetaOk = m => !!m && +m.store_id === LS_STORE && (!LS_PRODUCTS.length || LS_PRODUCTS.includes(+m.product_id));
const licView = o => o ? { key: o.key.slice(0, 4) + '••••' + o.key.slice(-4), name: o.name || '', email: o.email || '', ok: o.ok } : null;
// asks Lemon Squeezy; true = valid, false = definitely not (any more), null = no answer (offline)
async function licValidate(o) {
  const r = await lsCall('validate', { license_key: o.key, instance_id: o.inst });
  if (!r.net || r.status >= 500 || r.status === 429) return { v: null };
  const j = r.j || {}, st = j.license_key && j.license_key.status;
  if (j.valid && licMetaOk(j.meta) && st !== 'disabled' && st !== 'expired') return { v: true };
  return { v: false, why: st === 'expired' ? 'Deine Lizenz ist abgelaufen.' : st === 'disabled' ? 'Diese Lizenz wurde deaktiviert.' : 'Diese Lizenz gilt auf diesem Gerät nicht mehr.' };
}
function licRelock(why) {
  LIC_OK = false; LIC_WHY = why || '';
  for (const w of BrowserWindow.getAllWindows()) try { if (!w.isDestroyed() && /^capmap:\/\/app\//.test(w.webContents.getURL()) && !/recbar/.test(w.webContents.getURL())) w.loadURL('capmap://app/index.html'); } catch (e) {}
}
let LIC_WHY = '';
async function licBackground() {
  const o = licRead(); if (!o || Date.now() - o.ok < LIC_RECHECK) return;
  const r = await licValidate(o);
  if (r.v === true) licWrite({ ...o, ok: Date.now() });
  else if (r.v === false) { licClear(); licRelock(r.why); }
}
ipcMain.handle('lic-status', async () => {
  const o = licRead();
  if (!o) return { state: 'none', why: LIC_WHY, buy: LS_BUY };
  if (Date.now() - o.ok < LIC_RECHECK) { LIC_OK = true; return { state: 'ok', lic: licView(o), buy: LS_BUY }; }
  const r = await licValidate(o);
  if (r.v === true) { const n = { ...o, ok: Date.now() }; licWrite(n); LIC_OK = true; return { state: 'ok', lic: licView(n), buy: LS_BUY }; }
  if (r.v === false) { licClear(); LIC_OK = false; return { state: 'none', why: r.why, buy: LS_BUY }; }
  if (Date.now() - o.ok < LIC_GRACE) { LIC_OK = true; return { state: 'ok', offline: true, lic: licView(o), buy: LS_BUY }; }
  LIC_OK = false; return { state: 'offline', lic: licView(o), buy: LS_BUY };
});
ipcMain.handle('lic-activate', async (_e, raw) => {
