/* ---------- licence (Lemon Squeezy): without a valid key the window shows only the unlock page (web/lizenz.html).
   The key is activated once online; after that CapMap checks it quietly every day and keeps working 14 days offline. ---------- */
const LS_STORE = 503552, LS_PRODUCTS = [1486484];   // test-mode product; the live-mode copy gets its own ID, add it here
const LS_BUY = 'https://capclipmap.lemonsqueezy.com/checkout/buy/7cf9acec-8afb-4eb7-b4ea-9ece66ad3978';
const LIC_GRACE = 14 * 864e5, LIC_RECHECK = 864e5;
const licFile = () => path.join(app.getPath('userData'), 'lizenz.json');
const licSig = o => crypto.createHmac('sha256', 'cm-lic-7f3a91|' + os.hostname() + '|' + app.getPath('userData')).update([o.key, o.inst, o.ok].join('|')).digest('hex');
function licRead() { try { const o = JSON.parse(fs.readFileSync(licFile(), 'utf8')); return o && o.key && o.sig === licSig(o) ? o : null; } catch (e) { return null; } }
function licWrite(o) { o.sig = licSig(o); fs.writeFileSync(licFile(), JSON.stringify(o)); }
