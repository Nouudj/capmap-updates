  win.once('ready-to-show', () => { if (process.platform === 'win32' && winPref().fs !== false) win.setFullScreen(true); else win.maximize(); win.show(); });
  const sendState = () => { try { win.webContents.send('win-state', winState(win)); } catch (e) {} };
