  if (!/^[A-Za-z0-9-]{16,}$/.test(key)) return { err: 'Das sieht nicht nach einem Lizenzschlüssel aus. Kopiere ihn am besten direkt aus der E-Mail.' };
  const r = await lsCall('activate', { license_key: key, instance_name: (os.hostname() || 'Rechner') + ' · ' + ({ win32: 'Windows', darwin: 'Mac' }[process.platform] || process.platform) });
  if (!r.net) return { err: 'Keine Verbindung. Für die Freischaltung braucht CapMap einmal Internet.' };
  const j = r.j || {};
  if (!j.activated) {
    const e = String(j.error || '');
    if (/limit/i.test(e)) return { err: 'Dieser Schlüssel ist schon auf der erlaubten Anzahl Geräte aktiv. Melde ihn auf einem anderen Gerät ab (Optionen → Lizenz) und versuche es dann noch einmal.' };
    if (/expired/i.test(e)) return { err: 'Diese Lizenz ist abgelaufen.' };
    if (/disabled/i.test(e)) return { err: 'Diese Lizenz wurde deaktiviert.' };
    return { err: 'Dieser Lizenzschlüssel ist nicht gültig. Prüfe, ob du ihn vollständig kopiert hast.' };
