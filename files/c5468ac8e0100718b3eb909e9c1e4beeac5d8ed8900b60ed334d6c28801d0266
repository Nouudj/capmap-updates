const VIDEO_SITES = /(^|\.)(youtube\.com|youtu\.be|tiktok\.com|twitch\.tv|instagram\.com|x\.com|twitter\.com|vimeo\.com|facebook\.com|fb\.watch|reddit\.com|kick\.com|dailymotion\.com|soundcloud\.com)$/i;
function linkNormalize(u) {
  let url; try { url = new URL(String(u).trim()); } catch (e) { return null; }
  if (!/^https?:$/.test(url.protocol)) return null;
  const h = url.hostname.replace(/^www\./, '');
  // Google Drive and Dropbox share links → the direct file
  let m = /\/file\/d\/([\w-]+)/.exec(url.pathname);
  if (h === 'drive.google.com' && (m || url.searchParams.get('id'))) return { url: `https://drive.usercontent.google.com/download?id=${m ? m[1] : url.searchParams.get('id')}&export=download&confirm=t`, site: false };
  if (/dropbox\.com$/.test(h)) { url.searchParams.set('dl', '1'); return { url: url.href, site: false }; }
