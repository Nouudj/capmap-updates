    x: wa.x, y: wa.y, width: wa.width, height: wa.height, minWidth: 900, minHeight: 600,
    backgroundColor: '#000000', title: 'CapMap', autoHideMenuBar: true, show: false,
    // no grey system title bar: CapMap draws its own window buttons inside its top bar (the Mac keeps its traffic lights)
