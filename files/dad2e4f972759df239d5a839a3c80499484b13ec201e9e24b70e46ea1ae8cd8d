  const out = new Uint8Array(n); let o = 0; for (const c of ch) { out.set(c, o); o += c.length; } return out;
}
async function join(urls, count){ const b = []; for (const u of urls) b.push(await readAll(u, count)); const out = new Uint8Array(b.reduce((a, x) => a + x.length, 0)); let o = 0; for (const x of b) { out.set(x, o); o += x.length; } return out; }
