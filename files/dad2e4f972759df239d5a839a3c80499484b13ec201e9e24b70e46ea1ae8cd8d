}
const MODEL_DIR = BASE + 'models/Xenova/modnet/';
const realFetch = self.fetch.bind(self); let modelBuf = null;
self.fetch = async (input, init) => {
  const url = String(typeof input === 'string' ? input : (input && input.url) || input).split('?')[0];
  if (url.startsWith(MODEL_DIR)) {
    const rel = url.slice(MODEL_DIR.length);
    if (rel === 'onnx/model.onnx') { if (!modelBuf) modelBuf = await modelBytes(); return new Response(modelBuf, {status:200, headers:{'Content-Type':'application/octet-stream', 'Content-Length':String(modelBuf.length)}}); }
