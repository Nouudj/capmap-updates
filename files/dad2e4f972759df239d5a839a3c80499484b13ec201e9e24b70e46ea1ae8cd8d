let loaded = 0, lastReport = 0;
const report = () => { const n = Date.now(); if (n - lastReport > 150) { lastReport = n; postMessage({type:'progress', loaded, total:SIZE}); } };
async function readAll(url, count){
  const r = await realFetch(url); if (!r.ok) throw new Error('Datei fehlt: ' + url.split('/').pop());
