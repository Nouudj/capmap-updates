// Person cut-out worker for CapMap: MODNet portrait matting (Apache-2.0) with the ONNX runtime from transformers.js.
// The model is published in three parts (the host caps single files); where they are missing it comes once from the npm CDN.
const BASE = new URL('./', self.location.href).href, ASR = new URL('../asr/', self.location.href).href;
const PARTS = ['m0.wasm', 'm1.wasm', 'm2.wasm'], SIZE = 25888640;
const CDN = ['https://cdn.jsdelivr.net/npm/@rmbg/model-modnet@0.0.1/', 'https://unpkg.com/@rmbg/model-modnet@0.0.1/'], CDN_PARTS = ['modnet-1.onnx', 'modnet-2.onnx', 'modnet-3.onnx'];
