    postMessage({type:'status', text:'Präzise Freistellung wird geladen'});
    tf = await import(ASR + 'transformers.min.js');
    const env = tf.env; env.allowRemoteModels = false; env.allowLocalModels = true; env.localModelPath = BASE + 'models/'; env.useBrowserCache = false;
    const wasm = env.backends.onnx.wasm; wasm.numThreads = self.crossOriginIsolated ? Math.max(1, Math.min(4, (navigator.hardwareConcurrency || 2) - 1)) : 1; wasm.proxy = false;
    let local = false;
    try { const r = await realFetch(ASR + WASM.files[0]); local = r.ok; if (r.body && r.body.cancel) r.body.cancel(); } catch (err) {}
    if (local && !wasm.wasmBinary) { wasm.wasmPaths = ASR; wasm.wasmBinary = (await join(WASM.files.map(f => ASR + f), false)).buffer; }
    let m = null;
    let gpu = false; try { gpu = !!(self.navigator && navigator.gpu && await navigator.gpu.requestAdapter()); } catch (err) {}
    if (gpu) { try { m = await tf.AutoModel.from_pretrained('Xenova/modnet', {dtype:'fp32', device:'webgpu'}); device = 'webgpu'; } catch (err) { m = null; } }
