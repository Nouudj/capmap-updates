  try { return await join(PARTS.map(f => BASE + f), true); } catch (err) { loaded = 0; }
  const CACHE = 'capmap-modnet-v1', KEY = 'https://capmap.invalid/modnet.onnx';
  try { const c = await caches.open(CACHE), r = await c.match(KEY); if (r) return new Uint8Array(await r.arrayBuffer()); } catch (err) {}
  let last = null;
  for (const c of CDN) {
    try { loaded = 0; const b = await join(CDN_PARTS.map(f => c + f), true); try { await (await caches.open(CACHE)).put(KEY, new Response(b)); } catch (err) {} return b; }
