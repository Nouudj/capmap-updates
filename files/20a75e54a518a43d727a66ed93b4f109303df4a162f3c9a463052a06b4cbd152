<!doctype html><html lang="de"><head><meta charset="utf-8"><title>CapMap freischalten</title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<style>
:root{--fg:#f5f5f7;--muted:#a1a1a6;--faint:#6e6e73;--grad:linear-gradient(90deg,#8a7bff,#ff4fd8 55%,#ff9a5c)}
*{box-sizing:border-box}
html,body{margin:0;height:100%;background:#000;color:var(--fg);overflow:hidden;font:15px -apple-system,BlinkMacSystemFont,"SF Pro Text","Segoe UI Variable Text","Segoe UI",system-ui,sans-serif;-webkit-font-smoothing:antialiased;letter-spacing:-.01em}
.drag{position:fixed;inset:0 0 auto 0;height:44px;-webkit-app-region:drag;z-index:5}
.wbtn{position:fixed;top:8px;right:10px;display:flex;gap:4px;z-index:6;-webkit-app-region:no-drag}
.wbtn button{width:40px;height:30px;border:0;border-radius:8px;background:transparent;color:var(--muted);cursor:pointer;display:grid;place-items:center}
.wbtn button:hover{background:rgba(255,255,255,.08);color:#fff}.wbtn button.x:hover{background:#e5484d;color:#fff}
.wbtn svg{width:14px;height:14px}
html.mac .wbtn{display:none}
/* light: soft radial blobs moved by transform only (no animated blur) */
.sky{position:fixed;inset:-20%;pointer-events:none}
.sky i{position:absolute;width:60vmax;height:60vmax;border-radius:50%;opacity:.55;will-change:transform}
.sky i:nth-child(1){left:-5%;top:-10%;background:radial-gradient(closest-side,rgba(138,123,255,.55),rgba(138,123,255,.12) 55%,transparent);animation:a1 26s ease-in-out infinite alternate}
.sky i:nth-child(2){right:-10%;top:0;background:radial-gradient(closest-side,rgba(255,79,216,.45),rgba(255,79,216,.1) 55%,transparent);animation:a2 30s ease-in-out infinite alternate}
.sky i:nth-child(3){left:25%;bottom:-25%;background:radial-gradient(closest-side,rgba(255,154,92,.38),rgba(255,154,92,.08) 55%,transparent);animation:a3 34s ease-in-out infinite alternate}
@keyframes a1{to{transform:translate(12vw,8vh) scale(1.1)}}@keyframes a2{to{transform:translate(-10vw,10vh) scale(.92)}}@keyframes a3{to{transform:translate(6vw,-8vh) scale(1.08)}}
.vig{position:fixed;inset:0;pointer-events:none;background:radial-gradient(120% 90% at 50% 40%,transparent 40%,rgba(0,0,0,.75))}
main{position:relative;z-index:2;height:100%;display:grid;place-items:center;padding:24px}
.card{width:min(460px,100%);padding:38px 34px 30px;border-radius:28px;text-align:center;
  background:linear-gradient(180deg,rgba(255,255,255,.07),rgba(255,255,255,.025));box-shadow:inset 0 0 0 1px rgba(255,255,255,.09),0 40px 100px -30px rgba(0,0,0,.9);
  -webkit-backdrop-filter:blur(18px) saturate(1.4);backdrop-filter:blur(18px) saturate(1.4);animation:rise .9s cubic-bezier(.16,1,.3,1) both}
@keyframes rise{from{opacity:0;transform:translateY(18px) scale(.98)}}
.logo{width:64px;height:64px;margin:0 auto 18px;display:block;filter:drop-shadow(0 0 22px rgba(255,79,216,.35))}
h1{margin:0;font:700 34px/1.1 -apple-system,BlinkMacSystemFont,"SF Pro Display","Segoe UI Variable Display","Segoe UI",system-ui,sans-serif;letter-spacing:-.035em}
h1 b{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.sub{margin:10px 0 26px;color:var(--muted);line-height:1.5;font-size:14.5px}
.field{display:flex;align-items:center;gap:10px;height:52px;padding:0 16px;border-radius:999px;background:rgba(0,0,0,.35);box-shadow:inset 0 0 0 1px rgba(255,255,255,.12);transition:box-shadow .2s}
.field:focus-within{box-shadow:inset 0 0 0 1.5px rgba(255,79,216,.7),0 0 0 4px rgba(255,79,216,.14)}
.field svg{width:18px;height:18px;color:var(--faint);flex:none}
.field input{flex:1;min-width:0;border:0;background:transparent;color:var(--fg);font:500 15px "JetBrains Mono",ui-monospace,"SF Mono",Menlo,Consolas,monospace;letter-spacing:.02em;outline:none}
.field input::placeholder{color:var(--faint);font-family:inherit}
.go{position:relative;width:100%;height:50px;margin-top:12px;border:0;border-radius:999px;cursor:pointer;color:#fff;font-weight:600;font-size:15.5px;font-family:inherit;
  background:var(--grad);box-shadow:0 14px 34px -14px rgba(255,79,216,.75);transition:transform .35s cubic-bezier(.34,1.56,.64,1),filter .2s,opacity .2s}
.go:hover{filter:brightness(1.08);transform:translateY(-1px)}.go:active{transform:scale(.98)}
.go:disabled{opacity:.6;cursor:default;transform:none}
.go .sp{display:none;width:16px;height:16px;margin:0 auto;border-radius:50%;border:2px solid rgba(255,255,255,.5);border-top-color:#fff;animation:spin .7s linear infinite}
.go.busy span{display:none}.go.busy .sp{display:block}
@keyframes spin{to{transform:rotate(360deg)}}
.msg{min-height:20px;margin:14px 0 0;font-size:13.5px;line-height:1.45;color:#ff8f8f}
.msg.ok{color:#5ee08a}.msg.info{color:var(--muted)}
.buy{margin-top:18px;padding-top:18px;border-top:1px solid rgba(255,255,255,.08);color:var(--muted);font-size:13.5px}
.buy a{color:#fff;font-weight:600;text-decoration:none;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.buy a:hover{text-decoration:underline;text-decoration-color:#ff4fd8}
.lang{position:fixed;left:50%;bottom:18px;transform:translateX(-50%);z-index:3;display:flex;gap:2px;padding:3px;border-radius:999px;background:rgba(20,20,26,.42);box-shadow:inset 0 0 0 1px rgba(255,255,255,.12)}
.lang button{border:0;background:transparent;color:var(--muted);font-weight:600;font-size:12px;font-family:inherit;padding:5px 11px;border-radius:999px;cursor:pointer}
.lang button[aria-pressed=true]{background:rgba(255,255,255,.12);color:#fff}
.done .card{animation:out .6s cubic-bezier(.7,0,.84,0) forwards}
@keyframes out{to{opacity:0;transform:scale(1.04);filter:blur(6px)}}
@media (prefers-reduced-motion:reduce){.sky i,.card,.done .card{animation:none}.go{transition:none}}
</style></head><body>
<div class="drag"></div>
<div class="wbtn"><button onclick="W('min')" aria-label="Minimieren"><svg viewBox="0 0 16 16"><path d="M3 8h10" stroke="currentColor" stroke-width="1.4"/></svg></button><button class="x" onclick="W('close')" aria-label="Schließen"><svg viewBox="0 0 16 16"><path d="m4 4 8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.4"/></svg></button></div>
<div class="sky"><i></i><i></i><i></i></div><div class="vig"></div>
<main><form class="card" id="f" autocomplete="off">
  <svg class="logo" viewBox="0 0 64 64" fill="none"><defs><linearGradient id="g" x1="0" x2="1" y1="0" y2="1"><stop offset="0" stop-color="#8a7bff"/><stop offset=".55" stop-color="#ff4fd8"/><stop offset="1" stop-color="#ff9a5c"/></linearGradient></defs><path d="M8 52V18a6 6 0 0 1 10.6-3.9L32 30l13.4-15.9A6 6 0 0 1 56 18v34" stroke="url(#g)" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"/><path d="m27 41 12 7-12 7z" fill="#fff"/></svg>
  <h1 data-t="h">CapMap <b>freischalten</b></h1>
  <p class="sub" data-t="sub">Gib deinen Lizenzschlüssel ein. Du findest ihn in der E-Mail zu deinem Kauf.</p>
  <label class="field"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="15" r="4"/><path d="m11 12 9-9M17 6l3 3M14 9l2 2"/></svg>
    <input id="k" spellcheck="false" placeholder="XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX" data-tp="ph" aria-label="Lizenzschlüssel"></label>
  <button class="go" id="go" type="submit"><span data-t="go">Freischalten</span><i class="sp"></i></button>
  <p class="msg" id="m" role="status" aria-live="polite"></p>
  <div class="buy"><span data-t="nokey">Noch keinen Schlüssel?</span> <a id="buy" href="#" target="_blank" data-t="buy">CapMap kaufen</a></div>
</form></main>
<div class="lang"><button data-l="de">DE</button><button data-l="en">EN</button></div>
<script>
const N = window.capmapNative || {};
if (N.platform === 'darwin') document.documentElement.classList.add('mac');
const W = c => N.win && N.win(c);
const T = {
  de: {h:'CapMap <b>freischalten</b>', sub:'Gib deinen Lizenzschlüssel ein. Du findest ihn in der E-Mail zu deinem Kauf.', go:'Freischalten', nokey:'Noch keinen Schlüssel?', buy:'CapMap kaufen',
    checking:'Lizenz wird geprüft …', ok:'Freigeschaltet. Viel Spaß!', offline:'CapMap war länger offline. Verbinde dich kurz mit dem Internet, damit die Lizenz bestätigt werden kann.', retry:'Erneut prüfen', empty:'Bitte gib deinen Lizenzschlüssel ein.'},
  en: {h:'Unlock <b>CapMap</b>', sub:'Enter your license key. You will find it in your purchase email.', go:'Unlock', nokey:'No key yet?', buy:'Buy CapMap',
    checking:'Checking your license …', ok:'Unlocked. Have fun!', offline:'CapMap has been offline for a while. Connect to the internet briefly so your license can be confirmed.', retry:'Check again', empty:'Please enter your license key.'}
};
// messages from the app come in German; short English versions for the English page
const EN = {'Das sieht nicht nach':'That does not look like a license key. Copy it straight from the email.','Keine Verbindung. Für':'No connection. CapMap needs the internet once to unlock.',
  'Dieser Schlüssel ist schon':'This key is already active on the allowed number of devices. Sign it out on another device (Options → License) and try again.',
  'Diese Lizenz ist abgelaufen':'This license has expired.','Diese Lizenz wurde deaktiviert':'This license has been disabled.','Dieser Lizenzschlüssel ist nicht':'This license key is not valid. Check that you copied all of it.',
  'Dieser Schlüssel gehört nicht':'This key does not belong to CapMap.','Diese Lizenz gilt':'This license is no longer valid on this device.'};
let L = (() => { try { const s = localStorage.getItem('capmap:lang'); if (s) return s; } catch (e) {} return /^de/i.test(navigator.language || 'de') ? 'de' : 'en'; })();
const tr = s => { if (L !== 'en' || !s) return s; for (const k in EN) if (s.startsWith(k)) return EN[k]; return s; };
function setLang(l) {
  L = l; try { localStorage.setItem('capmap:lang', l); } catch (e) {}
  document.documentElement.lang = l;
  for (const el of document.querySelectorAll('[data-t]')) el.innerHTML = T[l][el.dataset.t];
  for (const b of document.querySelectorAll('.lang button')) b.setAttribute('aria-pressed', b.dataset.l === l);
  document.title = l === 'en' ? 'Unlock CapMap' : 'CapMap freischalten';
}
for (const b of document.querySelectorAll('.lang button')) b.onclick = () => setLang(b.dataset.l);
setLang(L);
const $k = document.getElementById('k'), $go = document.getElementById('go'), $m = document.getElementById('m');
const say = (t, cls) => { $m.textContent = t || ''; $m.className = 'msg' + (cls ? ' ' + cls : ''); };
function enter() { say(T[L].ok, 'ok'); document.body.classList.add('done'); setTimeout(() => N.licEnter && N.licEnter(), matchMedia('(prefers-reduced-motion:reduce)').matches ? 50 : 550); }
async function status() {
  if (!N.licStatus) return;
  const s = await N.licStatus().catch(() => null); if (!s) return;
  if (s.buy) document.getElementById('buy').href = s.buy;
  if (s.state === 'ok') return enter();
  if (s.state === 'offline') { say(T[L].offline, 'info'); $go.querySelector('span').textContent = T[L].retry; $go.dataset.retry = 1; return; }
  if (s.why) say(tr(s.why));
  setTimeout(() => $k.focus(), 300);
}
document.getElementById('f').onsubmit = async ev => {
  ev.preventDefault();
  if ($go.dataset.retry) { delete $go.dataset.retry; $go.querySelector('span').textContent = T[L].go; say(T[L].checking, 'info'); return status(); }
  const key = $k.value.trim(); if (!key) { say(T[L].empty); $k.focus(); return; }
  $go.disabled = true; $go.classList.add('busy'); say('');
  const r = await N.licActivate(key).catch(() => ({ err: 'Keine Verbindung. Für die Freischaltung braucht CapMap einmal Internet.' }));
  $go.disabled = false; $go.classList.remove('busy');
  if (r && r.ok) enter(); else say(tr(r && r.err));
};
$k.addEventListener('paste', () => setTimeout(() => { $k.value = $k.value.trim(); }, 0));
status();
</script>
</body></html>
