.ta-in-fade{--ta:aFade}.ta-in-pop{--ta:taPop}.ta-in-type{--ta:taType}.ta-in-slide{--ta:aU}.ta-in-zoomin{--ta:aZin}.ta-in-zoomout{--ta:aZout}.ta-in-left{--ta:aL}.ta-in-right{--ta:aR}.ta-in-up{--ta:aU}.ta-in-down{--ta:aD}.ta-in-spin{--ta:aSpin}.ta-in-blur{--ta:aBlur}
