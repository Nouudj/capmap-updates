const STAB_LV = [['off', 'Aus', 0], ['low', 'Leicht', 6], ['mid', 'Empfohlen', 14], ['high', 'Stark', 30]];
async function stabilize(c, lv){
  if (lv === 'off') { pushUndo(); delete c.stab; renderInspector(); toast('Stabilisierung aus'); return; }
  const sig = STAB_LV.find(x => x[0] === lv)[2];
  actModal('Video wird stabilisiert …', 'CapMap misst das Wackeln der Kamera Bild für Bild. Das dauert etwa so lange wie der Clip.');
  let frames, W = 160, H = 90;
  try { frames = await scanFrames(c, 15, 256, (d, w, h, t) => { W = w; H = h; return {t, g:grayOf(d, w, h)}; }, 'wird analysiert'); }
  catch (err) { actDone(); toast(err.message); return; }
  if (actDone()) { toast('Abgebrochen'); return; }
  if (frames.length < 3) { toast('Der Clip ist zu kurz zum Stabilisieren.'); return; }
  const px = [0], py = [0];
  for (let i = 1; i < frames.length; i++) { const [dx, dy] = motionBetween(frames[i - 1].g, frames[i].g, W, H); px.push(px[i - 1] + dx); py.push(py[i - 1] + dy); }
