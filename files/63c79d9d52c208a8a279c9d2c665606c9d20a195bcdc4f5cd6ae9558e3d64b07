  const lim = {low:.05, mid:.08, high:.12}[lv];
  const pts = frames.map((f, i) => [+f.t.toFixed(3), +clamp((px[i] - sx[i]) / W, -lim, lim).toFixed(4), +clamp((py[i] - sy[i]) / H, -lim, lim).toFixed(4)]);
  const mx = Math.max(.01, ...pts.map(p => Math.max(Math.abs(p[1]), Math.abs(p[2]))));
  pushUndo(); c.stab = {lv, zoom:+(1 / (1 - 2 * mx)).toFixed(3), pts};
  renderInspector(); toast('Video stabilisiert. Das Bild ist dafür leicht vergrößert.');
}
function stabAt(st, t){
  const P = st.pts; if (!P || !P.length) return [0, 0];
  if (t <= P[0][0]) return [P[0][1], P[0][2]]; if (t >= P[P.length - 1][0]) return [P[P.length - 1][1], P[P.length - 1][2]];
  let lo = 0, hi = P.length - 1; while (hi - lo > 1) { const md = (lo + hi) >> 1; if (P[md][0] <= t) lo = md; else hi = md; }
  const a = P[lo], b = P[hi], f = (t - a[0]) / Math.max(1e-6, b[0] - a[0]);
  return [a[1] + (b[1] - a[1]) * f, a[2] + (b[2] - a[2]) * f];
}

/* Farbe anpassen › automatisch: measures brightness, contrast and colour cast of the current frame */
function autoColor(list){
  let done = 0; pushUndo();
  for (const c of list) {
    const sr = clipSource(c); if (!sr) continue;
    const [src, iw, ih] = sr, w = 96, h = Math.max(8, Math.round(96 * ih / iw)), t = document.createElement('canvas'); t.width = w; t.height = h;
    const g = t.getContext('2d', {willReadFrequently:true}); g.drawImage(src, 0, 0, w, h);
    let d; try { d = g.getImageData(0, 0, w, h).data; } catch (err) { continue; }
    const L = [], n = d.length / 4; let r = 0, gg = 0, b = 0;
    for (let i = 0; i < d.length; i += 4) { r += d[i]; gg += d[i + 1]; b += d[i + 2]; L.push((d[i] * .2126 + d[i + 1] * .7152 + d[i + 2] * .0722) / 255); }
    r /= n * 255; gg /= n * 255; b /= n * 255; L.sort((x, y) => x - y);
    const mean = L.reduce((s, x) => s + x, 0) / n, lo = L[Math.floor(n * .02)], hi = L[Math.floor(n * .98)];
    const G = c.grade = {...(c.grade || {})};
    G.exp = Math.round(clamp(Math.log2(.46 / Math.max(.03, mean)) / 1.5 * 100 * .8, -60, 60));
    G.con = Math.round(clamp((.82 / Math.max(.2, hi - lo) - 1) / .008 * .6, -25, 35));
    G.temp = Math.round(clamp((b - r) / .2 * 100 * .6, -40, 40));
    G.tint = Math.round(clamp((gg - (r + b) / 2) / .08 * 100 * .6, -35, 35));
    G.sat = G.sat || 8; G.on = true;
    done++;
  }
  renderInspector();
  toast(done ? 'Farbe automatisch angepasst. Unter „Anpassen“ kannst du nachregeln.' : 'Stell den Abspielkopf auf den Clip, damit CapMap das Bild sehen kann.');
}
