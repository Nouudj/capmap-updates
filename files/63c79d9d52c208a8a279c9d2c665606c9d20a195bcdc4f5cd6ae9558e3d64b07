.kgrid h3{margin:0 0 2px;font-size:11px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.09em}
.krow{display:flex;justify-content:space-between;gap:12px;font-size:12.5px}
.krow span:first-child{min-width:0}
.krow span:last-child{flex:none;display:flex;gap:4px;flex-wrap:wrap;justify-content:flex-end}
.clip .fade{position:absolute;top:0;bottom:0;z-index:1;pointer-events:none}
.clip .fade.in{left:0;background:linear-gradient(to bottom right,rgba(0,0,0,.45) 50%,transparent 50%)}
.clip .fade.out{right:0;background:linear-gradient(to bottom left,rgba(0,0,0,.45) 50%,transparent 50%)}
.playhead{position:absolute;top:0;bottom:0;width:0;z-index:6;pointer-events:none}
.playhead::before{content:"";position:absolute;top:0;bottom:0;left:-1px;width:2px;background:var(--head)}
.playhead.snapped::before{width:3px;left:-1.5px;background:#fff;box-shadow:0 0 0 1px var(--head),0 0 10px var(--head)}
.playhead.snapped .knob{background:#fff;box-shadow:0 0 8px var(--head)}
.playhead::after{content:"";position:absolute;top:0;bottom:0;left:-6px;width:12px;pointer-events:auto;cursor:ew-resize;touch-action:none}
.playhead:hover::before{width:3px;left:-1.5px}
.playhead .knob{position:absolute;top:2px;left:-7px;width:14px;height:18px;background:var(--head);clip-path:polygon(0 0,100% 0,100% 60%,50% 100%,0 60%);pointer-events:auto;cursor:ew-resize}
.addtracks{display:flex;gap:6px;padding:8px 10px;position:sticky;left:0;width:max-content}
.addtracks button{border:1px dashed var(--line);background:transparent;border-radius:7px;padding:5px 10px;color:var(--muted);font-size:12px}
.addtracks button:hover{color:var(--fg);border-color:var(--muted)}

/* modal & toast */
.modal{position:fixed;inset:0;z-index:50;background:rgba(5,6,9,.72);display:grid;place-items:center;padding:20px max(16px, env(safe-area-inset-right,0px)) 20px max(16px, env(safe-area-inset-left,0px))}
.dlg{width:min(460px,100%);max-height:100%;overflow:auto;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:22px;display:flex;flex-direction:column;gap:16px}
.dlg h2{font-family:var(--f-display);font-size:22px;margin:0;letter-spacing:-.01em}
.dlg p{margin:0;color:var(--muted);line-height:1.5}
.bar{height:8px;border-radius:99px;background:var(--panel-2);overflow:hidden}
.bar i{display:block;height:100%;width:0;background:var(--accent);transition:width .2s linear}
.dlg video{width:100%;max-height:46vh;background:#000;border-radius:8px}
.dlg .acts{display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap}
.toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);z-index:60;background:var(--fg);color:var(--bg);padding:9px 14px;border-radius:9px;font-weight:600;max-width:calc(100% - 32px);box-shadow:0 8px 30px rgba(0,0,0,.4)}
.savest{font-size:12px;color:var(--muted);display:inline-flex;align-items:center;gap:6px;white-space:nowrap}
.savest::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--guide)}
.savest[data-st="saving"]::before{background:var(--k-text)}
.savest[data-st="off"]::before,.savest[data-st="error"]::before{background:var(--danger)}
.dlg.wide{width:min(640px,100%)}
.fontbtn{flex:1;min-width:0;display:flex;align-items:center;justify-content:space-between;gap:8px;height:32px;padding:0 10px;border:1px solid var(--line);border-radius:8px;background:var(--panel-2);color:var(--fg);font-size:15px;cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.fontbtn:hover{border-color:var(--accent)}
.fontpop{position:fixed;z-index:90;width:320px;height:420px;display:flex;flex-direction:column;gap:8px;padding:10px;background:var(--panel);border:1px solid var(--line);border-radius:12px;box-shadow:0 16px 44px rgba(0,0,0,.55)}
.fpcats{display:flex;flex-wrap:wrap;gap:4px}.fpcats button{border:1px solid var(--line);background:transparent;color:var(--muted);border-radius:12px;padding:3px 9px;font-size:11.5px;cursor:pointer}
.fpcats button[aria-pressed="true"]{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
.fplist{flex:1;overflow:auto;display:flex;flex-direction:column;gap:1px}
.fprow{display:flex;align-items:baseline;justify-content:space-between;gap:10px;border:0;background:transparent;color:var(--fg);text-align:left;padding:7px 9px;border-radius:7px;cursor:pointer;font-size:18px;line-height:1.25}
.fprow small{font-size:13px;color:var(--muted);flex:none}.fprow:hover{background:var(--raise)}.fprow.on{background:color-mix(in srgb,var(--accent) 18%,transparent);color:var(--accent)}
.fph{font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--faint);padding:8px 9px 3px;font-family:var(--f-ui)}
.thsec{margin:4px 0 14px}.thsec h3{font-size:14px;margin:0 0 4px;display:flex;align-items:center;gap:8px}.thsec h4{font-size:12.5px;margin:0 0 8px;color:var(--muted);display:flex;align-items:center;justify-content:space-between;gap:8px}
.thtag{font-size:11px;font-weight:600;color:var(--accent-ink);background:var(--accent);border-radius:10px;padding:1px 8px}
.thgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(132px,1fr));gap:10px;margin-top:10px}
.thcard{position:relative;border:2px solid;border-radius:12px;padding:8px;display:flex;flex-direction:column;gap:7px;text-align:left;cursor:pointer;transition:transform .12s}
.thcard:hover{transform:translateY(-2px)}.thcard[aria-pressed="true"]{box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 35%,transparent)}
.thmini{display:grid;grid-template-columns:1fr 2fr 1fr;gap:4px;height:46px}.thmini i{border-radius:5px;position:relative}.thmini b{position:absolute;left:18%;right:18%;bottom:7px;height:7px;border-radius:4px}
.thname{font-size:12.5px;font-weight:650}.thdot{position:absolute;top:12px;right:12px;width:10px;height:10px;border-radius:50%}
.thcols{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:8px}@media (max-width:600px){.thcols{grid-template-columns:1fr}}
.thsl{display:flex;flex-direction:column;gap:5px;margin-bottom:10px;font-size:12.5px}.thsl span{display:flex;justify-content:space-between}.thsl b{font-family:var(--f-mono);font-weight:500;color:var(--muted)}
.thsl input[type=range]{-webkit-appearance:none;appearance:none;width:100%;height:12px;border-radius:7px;background:var(--track);outline:none;border:1px solid var(--line)}
.thsl input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:18px;height:18px;border-radius:50%;background:#fff;border:3px solid rgba(0,0,0,.45);box-shadow:0 1px 4px rgba(0,0,0,.5);cursor:pointer}
.thsl input[type=range]::-moz-range-thumb{width:16px;height:16px;border-radius:50%;background:#fff;border:3px solid rgba(0,0,0,.45)}
#thPick{width:30px;height:22px;padding:0;border:1px solid var(--line);border-radius:6px;background:none;cursor:pointer}
.plist{display:flex;flex-direction:column;gap:8px;max-height:42vh;overflow:auto}
.prow{display:flex;align-items:center;gap:12px;padding:8px;border:1px solid var(--line);border-radius:10px;background:var(--panel-2)}
.pthumb{width:84px;height:50px;border-radius:6px;background:#000 center/contain no-repeat;flex:none}
.pinfo{flex:1;min-width:0;display:flex;flex-direction:column;gap:3px}
.pinfo b{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-weight:600}
.pinfo span{color:var(--muted);font-size:12px}
.pacts{display:flex;align-items:center;gap:6px;flex-wrap:wrap;justify-content:flex-end}
.empty{position:absolute;inset:0;display:grid;place-items:center;pointer-events:none;color:var(--muted);text-align:center;padding:20px;line-height:1.5}
.mcard.missing .mth{opacity:.3}
.trash{position:sticky;bottom:-12px;margin:auto -12px -12px;padding:12px;display:flex;align-items:center;justify-content:center;gap:8px;background:linear-gradient(transparent,var(--panel) 30%);color:var(--muted);font-size:12px;font-weight:600;cursor:default;z-index:2}
.trash::before{content:"";position:absolute;inset:12px 12px 12px;border:1.5px dashed var(--line);border-radius:10px;pointer-events:none;transition:border-color .12s,background .12s}
.trash svg{width:17px;height:17px;position:relative}.trash span,.trash small{position:relative}
.trash small{font-weight:400;color:#6b707b}
.trash{min-height:64px}
.trash.armed{color:var(--fg)}.trash.armed::before{border-color:var(--muted);background:rgba(255,255,255,.03)}
.trash.over{color:#ff6b6b}.trash.over small{color:#ff9a9a}.trash.over::before{border-color:#ff6b6b;border-style:solid;background:rgba(255,80,80,.10)}
.trash.over svg{animation:binWob .35s ease-in-out infinite alternate}
@keyframes binWob{from{transform:rotate(-8deg)}to{transform:rotate(8deg)}}
.btn.danger{background:#e5484d;border-color:#e5484d;color:#fff}.btn.danger:hover{background:#f2555a}
.mcard .add.relink{width:auto;padding:0 8px;font-size:11px;font-weight:600;background:var(--k-text);color:#1b1206}
.bar.busy i{background-image:repeating-linear-gradient(-45deg,rgba(255,255,255,.28) 0 8px,transparent 8px 16px);background-size:22.6px 22.6px;animation:stripes 1s linear infinite}
@keyframes stripes{to{background-position:22.6px 0}}
#hold{position:fixed;left:0;top:0;width:2px;height:2px;overflow:hidden;opacity:0;pointer-events:none}

