.ta-loop-pulse{--ta:taPulse}.ta-loop-float{--ta:taFloat}.ta-loop-wiggle{--ta:taWiggle}.ta-loop-swing{--ta:taSwing}.ta-loop-shake{--ta:taShake}.ta-loop-blink{--ta:taBlink}.ta-loop-bounce{--ta:taBounce}.ta-loop-glowp{--ta:taGlow}
