  const cut = (c, m) => { const D = m && isFinite(m.duration) && m.duration > 0 ? m.duration : keep.dur; c.in = Math.min(keep.a, Math.max(0, D - .1)); c.dur = Math.max(.1, Math.min(keep.b, D) - c.in); };
  if (scrM) {
    const c = clipFromMedia(scrM, main.id, 0); cut(c, scrM); c.fit = 'contain';
    const [aw, ah] = ASPECTS[asp], r = srRatio(keep.aspect); if (Math.abs(Math.log(aw / ah / r)) > .05) c.bg = 'blur';
    S.clips.push(c);
    if (camM && keep.cam) {
      const tr = addTrack('video', true), k = clipFromMedia(camM, tr.id, 0); cut(k, camM); k.dur = Math.min(k.dur, c.dur);
      const iw = camM.w || 1280, ih = camM.h || 720, W = cv.width, H = cv.height, Cm = keep.cam;
      k.fit = 'contain'; k.name = 'Kamera';
      if (Cm.shape === 'circle') { const q = (1 - Math.min(iw, ih) / Math.max(iw, ih)) / 2; k.crop = iw >= ih ? {l:q, r:q, t:0, b:0} : {l:0, r:0, t:q, b:q}; k.mask = {type:'circle', size:1, sw:1, sh:1, feather:0, rot:0, x:0, y:0, invert:false}; }
      else k.mask = {type:'rect', size:1, sw:1, sh:1, round:clamp(Cm.round ?? .28, 0, 1), feather:0, rot:0, x:0, y:0, invert:false};
      // the bubble keeps the width it had in the recorder preview, relative to the frame width
      const cw = k.crop ? Math.min(iw, ih) : iw, chh = k.crop ? Math.min(iw, ih) : ih, s0 = Math.min(W / cw, H / chh);
      k.scale = clamp(Cm.size * W / (cw * s0), .05, 5); k.x = Cm.x - .5; k.y = Cm.y - .5;
      S.clips.push(k);
    }
  }
  if (typeof hideHome === 'function' && HOME_OPEN) hideHome();
  S.t = 0; renderAll(); saveNow(true);
  const first = S.clips[0]; if (first) select(first.id);
  if (andSave) { toast('Aufnahme liegt im Projekt – jetzt nur noch exportieren.'); setTimeout(() => { const b = $('#exportBtn'); if (b) b.click(); }, 400); }
  else toast('Deine Aufnahme ist im Editor – viel Spaß beim Schneiden!');
}
// the start: a button on the home screen, right under „Neues Projekt erstellen“
document.addEventListener('click', e => { const b = e.target.closest('[data-hact="screenrec"]'); if (b) { e.preventDefault(); e.stopPropagation(); openScreenRec(); } }, true);
document.addEventListener('keydown', e => { if (e.key === 'Escape' && SR.open && (SR.stage === 'setup' || SR.stage === 'pick')) { e.stopPropagation(); srClose(); } }, true);


/* performance: pause the animations of areas that are scrolled out of sight, and everything while the app is hidden */
(function(){
  const SEL = '.hbanner,.hfmt.hqk,.cmfx,.cmphones,.cmeq,.welcome,.tlghost,.tlempty';
  const io = 'IntersectionObserver' in window ? new IntersectionObserver(es => { for (const e of es) { if (e.isIntersecting) e.target.removeAttribute('data-offv'); else e.target.setAttribute('data-offv', ''); } }) : null;
  const seen = new WeakSet(), scan = () => { if (!io) return; for (const el of document.querySelectorAll(SEL)) if (!seen.has(el)) { seen.add(el); io.observe(el); } };
  scan(); new MutationObserver(() => { clearTimeout(scan.t); scan.t = setTimeout(scan, 300); }).observe(document.body, {childList:true, subtree:true});
  const vis = () => document.documentElement.classList.toggle('pg-hidden', document.hidden);
  document.addEventListener('visibilitychange', vis); vis();
})();
})();
</script>
<script>
// desktop app: offline cache and an install button in the header
(function(){
  if ('serviceWorker' in navigator && location.protocol.startsWith('http')) navigator.serviceWorker.register('sw.js').catch(function(){});
  var deferred = null, standalone = matchMedia('(display-mode: standalone)').matches || matchMedia('(display-mode: window-controls-overlay)').matches;
  var btn = document.createElement('button');
  btn.className = 'btn'; btn.id = 'installBtn'; btn.hidden = true;
  btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4M12 7v6M9 10l3 3 3-3"/></svg>Als App installieren';
  var proj = document.getElementById('projBtn'); if (proj) proj.parentNode.insertBefore(btn, proj);
  window.addEventListener('beforeinstallprompt', function(e){ e.preventDefault(); deferred = e; if (!standalone) btn.hidden = false; });
  btn.addEventListener('click', function(){ if (!deferred) return; deferred.prompt(); deferred.userChoice.finally(function(){ deferred = null; btn.hidden = true; }); });
  window.addEventListener('appinstalled', function(){ btn.hidden = true; });
  // files opened with "Open with CapMap" land in the library
  if ('launchQueue' in window) window.launchQueue.setConsumer(async function(params){
    if (!params.files || !params.files.length) return;
    var files = []; for (var h of params.files) { try { files.push(await h.getFile()); } catch (err) {} }
    if (files.length) { var dt = new DataTransfer(); files.forEach(function(f){ dt.items.add(f); }); var inp = document.getElementById('fileIn'); inp.files = dt.files; inp.dispatchEvent(new Event('change')); }
  });
})();
</script>
