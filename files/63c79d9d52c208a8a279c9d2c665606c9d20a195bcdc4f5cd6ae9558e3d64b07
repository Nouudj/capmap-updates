  const out = []; let ul = false;
  for (const line of e.split('\n')) {
    const m = line.match(/^\s*(?:[-*•]|\d+[.)])\s+(.*)$/);
    if (m) { if (!ul) { out.push('<ul>'); ul = true; } out.push(`<li>${m[1]}</li>`); continue; }
    if (ul) { out.push('</ul>'); ul = false; }
    if (line.trim()) out.push(`<p>${line.replace(/^#+\s*/, '')}</p>`);
  }
  if (ul) out.push('</ul>');
  return out.join('');
}
