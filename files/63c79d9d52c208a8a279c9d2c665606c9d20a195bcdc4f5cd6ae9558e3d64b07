/* Audio optimieren: bring the clip to a common loudness (about -16 LUFS for speech, measured as RMS) */
async function normalizeLoud(list){
  const done = [];
  for (const c of list) {
    const m = S.media[c.mediaId]; if (!m || !m.file) continue;
    let pcm; try { pcm = await pcm16k(m); } catch (err) { continue; }
    const a = Math.floor(c.in * 16000), b = Math.min(pcm.length, Math.floor((c.in + c.dur * c.speed) * 16000));
    // loudness of the louder half of the clip, so pauses do not count
    const blk = 1600, rms = [];
    for (let i = a; i + blk <= b; i += blk) { let s = 0; for (let j = i; j < i + blk; j++) s += pcm[j] * pcm[j]; rms.push(Math.sqrt(s / blk)); }
    if (!rms.length) continue;
    rms.sort((x, y) => y - x); const top = rms.slice(0, Math.max(1, Math.ceil(rms.length / 2)));
    const level = Math.sqrt(top.reduce((s, x) => s + x * x, 0) / top.length); if (level < 1e-4) continue;
    let peak = 0; for (let j = a; j < b; j++) peak = Math.max(peak, Math.abs(pcm[j]));
    const gain = Math.min(Math.pow(10, -18 / 20) / level, .98 / Math.max(peak, 1e-4), 4);
    done.push([c, gain]);
  }
  if (!done.length) { toast('Für diesen Clip ließ sich der Ton nicht messen.'); return; }
  pushUndo(); for (const [c, g] of done) c.volume = +g.toFixed(3);
  renderTimeline(); renderInspector();
  toast(done.length > 1 ? `Lautstärke von ${done.length} Clips angeglichen` : `Lautstärke angeglichen (${(20 * Math.log10(done[0][1])).toFixed(1).replace('.', ',')} dB)`);
}
