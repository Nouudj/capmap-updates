function parseSubs(txt){
  const out = [], tm = s => { const m = s.trim().replace(',', '.').match(/(?:(\d+):)?(\d+):(\d+)(?:\.(\d+))?/); if (!m) return null; return (+(m[1] || 0)) * 3600 + (+m[2]) * 60 + (+m[3]) + (m[4] ? +('0.' + m[4]) : 0); };
  for (const block of txt.replace(/\r/g, '').split(/\n\s*\n/)) {
    const lines = block.split('\n').filter(l => l.trim()); const i = lines.findIndex(l => l.includes('-->')); if (i < 0) continue;
    const [a, b] = lines[i].split('-->'), s = tm(a), e = tm(b.split(' ').filter(Boolean)[0] || '');
    const text = lines.slice(i + 1).join('\n').replace(/<[^>]+>/g, '').replace(/\{\\[^}]*\}/g, '').trim();
    if (s != null && e != null && e > s && text) out.push({s, e, text});
  }
  return out;
}
