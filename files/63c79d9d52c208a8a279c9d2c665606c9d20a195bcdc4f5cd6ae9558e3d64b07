function cmLocalPick(sents, n, [lo, hi]){
  const strong = /\b(krass|wahnsinn|unglaublich|geheim|niemand|nie|immer|fehler|wichtig|achtung|warum|wtf|omg|lol|beste|schlimmste|erste|letzte|wirklich|ehrlich|krank|mega|geil|hammer|stopp|digga|alter|bruder|never|best|worst|secret)\b/gi;
  const cands = [];
  for (let i = 0; i < sents.length; i++) {
    let j = i, score = 0;
    while (j < sents.length && sents[j].e - sents[i].s < hi) {
      const t = sents[j].text, d = Math.max(.5, sents[j].e - sents[j].s);
      score += (t.split(/\s+/).length / d) * .6 + ((t.match(/[!?]/g) || []).length) * 1.4 + ((t.match(strong) || []).length) * 1.1 + (/\d/.test(t) ? .6 : 0);
      if (sents[j].e - sents[i].s >= lo) cands.push({s:sents[i].s, e:sents[j].e, score:score / Math.max(1, j - i + 1) * Math.sqrt(j - i + 1), i});
      j++;
    }
  }
  cands.sort((a, b) => b.score - a.score);
  const pick = [];
  for (const c of cands) { if (pick.length >= n) break; if (pick.some(p => c.s < p.e && p.s < c.e)) continue; pick.push(c); }
  const max = pick.length ? pick[0].score : 1;
  return pick.map(p => {
    const words = sents[p.i].text.replace(/[.!?…,]+$/, '').split(/\s+/);
    return {s:p.s, e:p.e, score:Math.round(55 + 40 * p.score / max), title:words.slice(0, 7).join(' '), desc:sents[p.i].text, tags:'', why:'Viel Sprache, starke Worte'};
  });
}
async function cmAiPick(sents, n, [lo, hi], name){
  const lines = sents.map(s => `[${s.s.toFixed(1)}-${s.e.toFixed(1)}] ${s.text}`).join('\n').slice(0, 90000);
  const prompt = `Du bist ein Profi für virale Kurzvideos (TikTok, Reels, YouTube Shorts). Unten ist das Transkript eines langen Videos ("${name}") mit Zeiten in Sekunden.
Finde die ${n} besten Momente, die als eigenständiger Short funktionieren: starker Einstieg in den ersten 2 Sekunden (Frage, Behauptung, Überraschung, Emotion, Pointe), in sich verständlich ohne Vorwissen, klares Ende.
Jeder Clip ist ${lo} bis ${hi} Sekunden lang, beginnt am Anfang eines Satzes und endet am Ende eines Satzes. Clips dürfen sich nicht überschneiden.
Schreib für jeden Clip in der Sprache des Videos:
- "title": Hook-Titel, maximal 6 Wörter, neugierig machend, gern mit Ausrufezeichen, ohne Lügen
- "desc": 2–3 Sätze, warum der Moment fesselt (wie eine Redaktionsnotiz)
- "tags": 4–6 passende Hashtags in einem String
- "score": virales Potenzial 0–100, ehrlich verteilt
Antworte NUR mit JSON in genau dieser Form, ohne weiteren Text:
{"clips":[{"start":12.3,"end":48.9,"title":"…","desc":"…","tags":"#… #…","score":87}]}

Transkript:
${lines}`;
  const txt = await llmText(prompt); if (txt == null) return null;
  const m = txt.match(/\{[\s\S]*\}/); if (!m) throw new Error('Die Antwort der KI war kein JSON.');
  const j = JSON.parse(m[0]), arr = Array.isArray(j.clips) ? j.clips : [];
  return arr.map(c => ({s:+c.start, e:+c.end, title:String(c.title || '').trim(), desc:String(c.desc || '').trim(), tags:String(c.tags || '').trim(), score:clamp(Math.round(+c.score || 60), 0, 100), why:''}))
    .filter(c => isFinite(c.s) && isFinite(c.e) && c.e - c.s >= 5);
}
// clip edges exactly on word starts/ends, so nothing is cut mid-word
function cmSnap(c, words, total){
  if (!words.length) return c;
  let a = words.findIndex(w => w.e > c.s - .05); if (a < 0) a = 0;
  let b = -1; for (let i = words.length - 1; i >= 0; i--) if (words[i].s < c.e + .05) { b = i; break; } if (b < a) b = a;
  return {...c, s:Math.max(0, words[a].s - .12), e:Math.min(total, words[b].e + .25)};
}
// a vertical (9:16) preview picture of a moment, framed on the person when the person finder is there
async function cmThumb(url, t){
  return new Promise(res => {
    const v = document.createElement('video'); v.muted = true; v.preload = 'auto'; v.src = url;
    let fin = false; const done = (u, px) => { if (fin) return; fin = true; v.removeAttribute('src'); v.load(); res({thumb:u, px}); };
    v.onloadeddata = () => { v.currentTime = Math.min(t + .6, (v.duration || t + 1) - .1); };
    v.onseeked = async () => {
      try {
        let px = .5;
        if (SEG.state === 'ready') { const sc = document.createElement('canvas'), k = 256 / Math.max(1, v.videoWidth); sc.width = 256; sc.height = Math.round(v.videoHeight * k); sc.getContext('2d').drawImage(v, 0, 0, sc.width, sc.height); const u = personX(await segOnce(sc)); if (u != null) px = u; }
        const H = 480, W = 270, c = document.createElement('canvas'); c.width = W; c.height = H;
        const s = H / v.videoHeight, dw = v.videoWidth * s, x = clamp(W / 2 - px * dw, W - dw, 0);
        c.getContext('2d').drawImage(v, x, 0, dw, H); done(c.toDataURL('image/jpeg', .72), px);
      } catch (err) { done('', .5); }
    };
    v.onerror = () => done('', .5); setTimeout(() => done('', .5), 9000);
  });
}
