/* ---------- Tracking, Verpixeln, Retusche: glass tiles and the target circle ---------- */
.ghd{margin:2px 0 8px;font-size:12px;font-weight:600;letter-spacing:.01em;color:var(--muted)}
.gtiles{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin:0 0 12px}.gtiles.g3{grid-template-columns:repeat(3,1fr)}
.gtile{position:relative;display:flex;flex-direction:column;align-items:center;gap:8px;padding:12px 6px 10px;border:0;border-radius:18px;cursor:pointer;color:var(--fg);font:inherit;font-size:12px;
  background:linear-gradient(180deg,rgba(255,255,255,.07),rgba(255,255,255,.025));box-shadow:inset 0 0 0 1px rgba(255,255,255,.09);-webkit-backdrop-filter:blur(18px) saturate(1.4);backdrop-filter:blur(18px) saturate(1.4);
  transition:box-shadow .25s,transform .35s cubic-bezier(.34,1.56,.64,1),background .25s}
.gtile:hover{background:linear-gradient(180deg,rgba(255,255,255,.1),rgba(255,255,255,.035));transform:translateY(-1px)}
.gtile:active{transform:scale(.97)}
.gtile[aria-pressed="true"]{box-shadow:inset 0 0 0 1.5px var(--accent),0 0 0 1px rgba(var(--accR),.25),0 8px 24px -14px rgba(var(--accR),.8)}
.gico{display:grid;place-items:center;width:54px;height:54px;border-radius:15px;background:linear-gradient(180deg,rgba(var(--accR),.16),rgba(var(--accR),.05));box-shadow:inset 0 0 0 1px rgba(255,255,255,.12)}
.gico svg{width:26px;height:26px;color:var(--accHi);filter:drop-shadow(0 0 6px rgba(var(--accR),.75))}
.gtl{font-weight:600;line-height:1.2;text-align:center}
.gchk{position:absolute;top:7px;right:7px;display:grid;place-items:center;width:18px;height:18px;border-radius:999px;background:var(--accent);color:#fff;box-shadow:0 0 10px rgba(var(--accR),.7)}
.gchk svg{width:11px;height:11px}
.gpill{display:inline-flex;align-items:center;height:20px;padding:0 9px;border-radius:999px;background:rgba(20,20,26,.42);-webkit-backdrop-filter:blur(14px) saturate(1.6);backdrop-filter:blur(14px) saturate(1.6);box-shadow:inset 0 0 0 1px rgba(255,255,255,.18);color:#fff;font-weight:600;font-size:11px;margin-right:4px}
.trkgo{width:100%;display:flex;align-items:center;justify-content:center;gap:8px;border-radius:999px}
.trkgo svg{width:18px;height:18px}
.fbst:empty{display:none}
.ovtrk{position:absolute;left:0;top:0;border-radius:50%;pointer-events:auto;cursor:move;touch-action:none;z-index:6;
  box-shadow:0 0 0 2px rgba(255,255,255,.95),0 0 0 4px rgba(var(--accR),.45),0 0 18px 2px rgba(var(--accR),.55),inset 0 0 24px rgba(var(--accR),.25);background:rgba(var(--accR),.08)}
.ovtrk.done{box-shadow:0 0 0 2px rgba(255,255,255,.95),0 0 0 4px rgba(52,199,89,.45),0 0 18px 2px rgba(52,199,89,.5),inset 0 0 24px rgba(52,199,89,.2);background:rgba(52,199,89,.06)}
.ovtrk .otc{position:absolute;left:50%;top:50%;width:14px;height:14px;transform:translate(-50%,-50%);pointer-events:none}
.ovtrk .otc::before,.ovtrk .otc::after{content:'';position:absolute;background:#fff;border-radius:2px;box-shadow:0 0 4px rgba(0,0,0,.6)}
.ovtrk .otc::before{left:6px;top:0;width:2px;height:14px}.ovtrk .otc::after{top:6px;left:0;width:14px;height:2px}
.ovtrk .otr{position:absolute;right:-7px;top:50%;width:14px;height:14px;margin-top:-7px;border-radius:50%;background:#fff;box-shadow:0 0 0 2px var(--accent),0 2px 8px rgba(0,0,0,.5);cursor:ew-resize}
@media (prefers-reduced-motion:reduce){.gtile{transition:none}.gtile:hover{transform:none}}
/* desktop app: accents ~20 % more vivid (banner, icon tiles, highlights, primary buttons) – never the video preview or thumbnails */
html.desk .hbanner,html.desk .hfic2,html.desk .cmnav,html.desk .tplart,html.desk .mark,html.desk .btn.primary,html.desk .gico,html.desk .gchk,html.desk .aibtn,html.desk .hsbar,html.desk .hnav.on{filter:saturate(1.22) contrast(1.03)}
html.desk .cmnav:hover{filter:saturate(1.22) contrast(1.03) brightness(1.12)}
/* ---------- Bildschirmaufnahme ---------- */
.hquick{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px;margin:14px 0 4px}
.home .hfmt.hqk{grid-column:span 2;position:relative}
.home .hfmt.hqk{overflow:hidden;isolation:isolate}
/* a fine pink→purple light edge and a slow light sweep, so the recorder stands out a little */
.home .hfmt.hqk::before{content:'';position:absolute;inset:0;border-radius:inherit;padding:1px;pointer-events:none;background:linear-gradient(110deg,rgba(var(--gCr),.55),rgba(var(--gAr),.25) 35%,transparent 60%,rgba(var(--gCr),.35));-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude}
.home .hfmt.hqk::after{content:'';position:absolute;top:0;bottom:0;left:-40%;width:35%;pointer-events:none;z-index:-1;filter:none;will-change:transform;background:linear-gradient(100deg,transparent,rgba(var(--gCr),.10) 40%,rgba(var(--gB5r),.16) 50%,rgba(var(--gCr),.10) 60%,transparent);animation:hqsweep 6s cubic-bezier(.45,0,.2,1) infinite}
@keyframes hqsweep{0%{transform:translateX(0)}55%,100%{transform:translateX(420%)}}
.home .hfmt.hqk:hover{box-shadow:inset 0 0 0 1px rgba(255,255,255,.09),0 18px 40px -22px rgba(var(--gCr),.55)}
@media (prefers-reduced-motion:reduce){.home .hfmt.hqk::after{animation:none;opacity:0}}
