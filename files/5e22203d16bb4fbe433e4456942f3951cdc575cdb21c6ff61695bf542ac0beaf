}
async function smallFromCache(){
  if (!self.caches) return null;
  try {
    const c = await caches.open(SMALL_CACHE), out = {};
    for (const n of SMALL_NEED) { const r = await c.match(SMALL_KEY + n); if (!r) return null; out[n] = new Uint8Array(await r.arrayBuffer()); }
    return out;
  } catch (err) { return null; }
}
/* stream the .tgz: gunzip with DecompressionStream, walk the tar headers, keep only the model files */
async function smallFromTgz(){
  const urls = tgzOverride ? [tgzOverride] : MODELS.small.tgz;
  let last = null;
  for (const url of urls) {
    try {
      const r = await origFetch(url); if (!r.ok || !r.body) throw new Error('Download fehlgeschlagen (' + r.status + ')');
      total = +r.headers.get('content-length') || MODELS.small.tgzSize; loaded = 0;
      const counted = r.body.pipeThrough(new TransformStream({transform(chunk, ctl){ loaded += chunk.length; report(); ctl.enqueue(chunk); }}));
      const reader = counted.pipeThrough(new DecompressionStream('gzip')).getReader();
      const pre = 'package/models/Xenova/whisper-small/', got = await untarPick(reader, n => n.startsWith(pre) && SMALL_NEED.includes(n.slice(pre.length)));
      const out = {}; for (const [n, d] of Object.entries(got)) out[n.slice(pre.length)] = d;
      for (const n of SMALL_NEED) if (!out[n]) throw new Error('Im Paket fehlt ' + n);
      if (self.caches) { try { const c = await caches.open(SMALL_CACHE); for (const n of SMALL_NEED) await c.put(SMALL_KEY + n, new Response(out[n])); } catch (err) {} }
      return out;
    } catch (err) { last = err; }
  }
  throw last || new Error('Download fehlgeschlagen');
}
async function loadSmall(){
  if (smallFiles) return smallFiles;
  postMessage({type:'status', text:'Sehr genaue Spracherkennung wird geladen'});
  smallFiles = await smallFromCache();
  if (!smallFiles) { postMessage({type:'status', text:'Sehr genaue Spracherkennung wird heruntergeladen (einmalig, ca. 166 MB)'}); smallFiles = await smallFromTgz(); }
  return smallFiles;
}
const CDNS = [p => `https://cdn.jsdelivr.net/npm/${p}`, p => `https://unpkg.com/${p}`];
const WASM = {files:['ort0.wasm', 'ort1.wasm'], size:21596019};
let loaded = 0, total = 1;
const origFetch = self.fetch.bind(self);

async function readAll(url, count){
  const r = await origFetch(url);
  if (!r.ok) throw new Error('Datei fehlt: ' + url.split('/').pop());
  if (!r.body || !r.body.getReader) { const b = await r.arrayBuffer(); if (count) { loaded += b.byteLength; report(); } return new Uint8Array(b); }
  const reader = r.body.getReader(); const chunks = []; let n = 0;
  for (;;) { const {done, value} = await reader.read(); if (done) break; chunks.push(value); n += value.length; if (count) { loaded += value.length; report(); } }
  const out = new Uint8Array(n); let o = 0; for (const c of chunks) { out.set(c, o); o += c.length; }
  return out;
}
let lastReport = 0;
function report(){ const now = Date.now(); if (now - lastReport > 120) { lastReport = now; postMessage({type:'progress', loaded, total}); } }
async function joinParts(dirUrl, files){
  const bufs = []; for (const f of files) bufs.push(await readAll(dirUrl + f, true));
  const size = bufs.reduce((a, b) => a + b.length, 0), out = new Uint8Array(size); let o = 0;
  for (const b of bufs) { out.set(b, o); o += b.length; }
  return out;
}
async function fromCdn(path, count){
  let last = null;
  for (const c of CDNS) { try { return await readAll(c(path), count); } catch (err) { last = err; } }
  throw last || new Error('cdn');
}
const localOk = {};
async function hasLocal(key){
  if (key in localOk) return localOk[key];
  try { const r = await origFetch(BASE + 'models/' + MODELS[key].id + '/config.json'); localOk[key] = r.ok; } catch (err) { localOk[key] = false; }
  return localOk[key];
}
self.fetch = async (input, init) => {
  const url = typeof input === 'string' ? input : (input && input.url) || String(input);
  const clean = url.split('?')[0];
  for (const [key, M] of Object.entries(MODELS)) {
    const pre = BASE + 'models/' + M.id + '/';
    if (!clean.startsWith(pre)) continue;
    if (key === 'small') {
      const rel = clean.slice(pre.length), f = smallFiles && smallFiles[rel];
      if (!f) return new Response('not found', {status:404});
      return new Response(f, {status:200, headers:{'Content-Type':rel.endsWith('.json') ? 'application/json' : 'application/octet-stream', 'Content-Length':String(f.length)}});
    }
    const rel = clean.slice(pre.length), name = rel.split('/').pop(), p = M.parts[name];
    const local = await hasLocal(key);
    let buf;
    if (local) {
      if (!p) return origFetch(input, init);
      buf = await joinParts(pre + 'onnx/', p.files);
    } else buf = await fromCdn(`${M.npm}/models/${M.id}/${rel}`, !!p);
    return new Response(buf, {status:200, headers:{'Content-Type':name.endsWith('.json') ? 'application/json' : 'application/octet-stream', 'Content-Length':String(buf.length)}});
  }
  return origFetch(input, init);
};

let tf = null; const pipes = {};
async function getPipe(key){
  if (pipes[key]) return pipes[key];
  if (key === 'small') await loadSmall();
  postMessage({type:'status', text:key === 'small' ? 'Sehr genaue Spracherkennung wird gestartet' : key === 'base' ? 'Genaue Spracherkennung wird geladen' : 'Spracherkennung wird geladen'});
  loaded = 0; total = Object.values(MODELS[key].parts).reduce((a, p) => a + p.size, 0);
  if (!tf) {
    tf = await import('./transformers.min.js');
    const env = tf.env;
    env.allowRemoteModels = false; env.allowLocalModels = true; env.localModelPath = BASE + 'models/'; env.useBrowserCache = false;
    const wasm = env.backends.onnx.wasm; wasm.numThreads = 1; wasm.proxy = false;
    // the speech runtime comes from the local folder when it is there, otherwise from the jsDelivr CDN
    let local = false;
    try { const r = await origFetch(BASE + WASM.files[0]); local = r.ok; if (r.body && r.body.cancel) r.body.cancel(); } catch (err) { local = false; }
