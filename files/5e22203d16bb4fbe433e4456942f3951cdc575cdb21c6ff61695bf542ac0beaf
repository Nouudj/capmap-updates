  base:{id:'Xenova/whisper-base', npm:'sts-whisper-base@1.0.0', parts:{
    'encoder_model_quantized.onnx':{files:['enc0.wasm', 'enc1.wasm', 'enc2.wasm'], size:23200850},
    'decoder_model_merged_quantized.onnx':{files:['dec0.wasm', 'dec1.wasm', 'dec2.wasm', 'dec3.wasm', 'dec4.wasm'], size:53707539}}},
  // "small" is too big to ship inside CapMap: it comes once as the npm package archive (CORS-open registry), is unpacked here and kept in the browser cache
  small:{id:'Xenova/whisper-small', tgz:['https://registry.npmjs.org/sts-whisper-small/-/sts-whisper-small-1.0.0.tgz'], tgzSize:165623913, parts:{
    'encoder_model_quantized.onnx':{size:92324809}, 'decoder_model_merged_quantized.onnx':{size:156780950}}},
};
const SMALL_CACHE = 'capmap-whisper-small-v1', SMALL_KEY = 'https://capmap.invalid/whisper-small/';
const SMALL_NEED = ['config.json', 'generation_config.json', 'preprocessor_config.json', 'tokenizer.json', 'tokenizer_config.json', 'added_tokens.json', 'special_tokens_map.json', 'normalizer.json', 'vocab.json', 'merges.txt', 'onnx/encoder_model_quantized.onnx', 'onnx/decoder_model_merged_quantized.onnx'];
let smallFiles = null, tgzOverride = null;
// streaming tar reader: calls want(name) -> boolean, returns {name: Uint8Array}
async function untarPick(reader, want){
