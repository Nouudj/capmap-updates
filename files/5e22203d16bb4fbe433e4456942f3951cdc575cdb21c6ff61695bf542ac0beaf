      for (const mode of msg.ts === 'word' ? ['word', true] : [true]) {
        try { out = await p(msg.audio, {...opts, return_timestamps:mode}); ts = mode === 'word' ? 'word' : 'phrase'; break; } catch (err) { console.warn('timestamps', mode, err); out = null; }
      }
    }
    if (!out) out = await p(msg.audio, opts);
