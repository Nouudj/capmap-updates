}

self.onmessage = async e => {
  const msg = e.data;
  if (msg.type !== 'run') return;
  let key = MODELS[msg.model] ? msg.model : 'base';
  if (msg.tgz) tgzOverride = msg.tgz;
  try {
    let p;
    try { p = await getPipe(key); }
    catch (err) {
      console.warn('model', key, err);
      if (key === 'small') { smallFiles = null; postMessage({type:'fallback', from:'small', to:'base', why:String(err && err.message || err)}); key = 'base'; try { p = await getPipe('base'); } catch (e2) { postMessage({type:'fallback', from:'base', to:'tiny'}); key = 'tiny'; p = await getPipe('tiny'); } }
      else if (key === 'base') { postMessage({type:'fallback', from:'base', to:'tiny'}); key = 'tiny'; p = await getPipe('tiny'); } else throw err;
    }
