<!doctype html><html lang="de"><head><meta charset="utf-8"><title>CapMap Aufnahme</title>
<style>
html,body{margin:0;height:100%;background:transparent;overflow:hidden;font:600 14px -apple-system,BlinkMacSystemFont,"Segoe UI Variable Text","Segoe UI",system-ui,sans-serif;color:#fff;user-select:none}
.bar{position:absolute;inset:6px;display:flex;align-items:center;gap:10px;padding:0 8px 0 16px;border-radius:999px;-webkit-app-region:drag;
  background:linear-gradient(180deg,rgba(255,255,255,.1),rgba(255,255,255,.03)),rgba(16,16,22,.88);box-shadow:inset 0 0 0 1px rgba(255,255,255,.18),0 8px 24px rgba(0,0,0,.45)}
.dot{width:11px;height:11px;border-radius:50%;background:#ff3b4f;box-shadow:0 0 10px #ff3b4f;animation:b 1.2s ease-in-out infinite}.p .dot{animation:none;opacity:.45}
@keyframes b{50%{opacity:.35}}
.t{font:600 15px "JetBrains Mono",ui-monospace,Menlo,Consolas,monospace;min-width:58px;font-variant-numeric:tabular-nums}
.sp{flex:1}
button{-webkit-app-region:no-drag;display:inline-flex;align-items:center;gap:6px;height:36px;padding:0 14px;border:0;border-radius:999px;color:#fff;font:inherit;font-size:13px;cursor:pointer;background:rgba(255,255,255,.1);box-shadow:inset 0 0 0 1px rgba(255,255,255,.12)}
button:hover{background:rgba(255,255,255,.18)}
.stop{background:#ff3b4f;box-shadow:0 0 14px rgba(255,59,79,.55)}.stop:hover{background:#ff5466}
.stop i{width:10px;height:10px;border-radius:2px;background:#fff}
svg{width:14px;height:14px}
@media (prefers-reduced-motion:reduce){.dot{animation:none}}
</style></head><body>
<div class="bar" id="bar"><span class="dot"></span><span class="t" id="t">00:00</span><span class="sp"></span>
<button id="pause" title="Pause"><svg viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg><span>Pause</span></button>
<button class="stop" id="stop" title="Aufnahme beenden"><i></i>Stopp</button></div>
<script>
const N = window.capmapNative, f = s => { s = Math.max(0, Math.floor(s)); const h = Math.floor(s / 3600), m = Math.floor(s / 60) % 60, x = s % 60; return (h ? h + ':' : '') + String(m).padStart(2, '0') + ':' + String(x).padStart(2, '0'); };
const P = '<svg viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg><span>Pause</span>', R = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M7 5v14l12-7z"/></svg><span>Weiter</span>';
let paused = false;
if (N && N.onRecState) N.onRecState(st => { document.getElementById('t').textContent = f(st.t); if (st.paused !== paused) { paused = st.paused; document.getElementById('bar').classList.toggle('p', paused); document.getElementById('pause').innerHTML = paused ? R : P; } });
document.getElementById('pause').onclick = () => N && N.recCmd('pause');
document.getElementById('stop').onclick = () => N && N.recCmd('stop');
</script></body></html>
